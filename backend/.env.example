# Copy to backend/.env and adjust. Real environment variables take precedence.

# PostgreSQL (docker compose up -d db gives you exactly this one)
DATABASE_URL=postgresql+psycopg://foodchainiq:foodchainiq@localhost:5432/foodchainiq

# Where uploaded dataset files are stored: <STORAGE_DIR>/datasets/<id>/v<n>/
STORAGE_DIR=./storage

# CHANGE IN PRODUCTION — signs the access tokens
JWT_SECRET=dev-only-change-me-in-production-0123456789
ACCESS_TOKEN_TTL_S=900
REFRESH_TOKEN_TTL_S=604800
# true behind HTTPS
COOKIE_SECURE=false
# strict | lax | none  (none + COOKIE_SECURE=true when the frontend is on another site)
COOKIE_SAMESITE=strict

# First-run platform admin (created if missing)
ADMIN_EMAIL=admin@foodchainiq.local
ADMIN_PASSWORD=admin1234
# Demo users, groups and sample datasets on an empty database
SEED_DEMO=true

# Limits
MAX_UPLOAD_BYTES=2147483648
DEFAULT_QUOTA_BYTES=10737418240
MAX_SELECTION_SIZE=20

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
