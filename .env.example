# FoodChainIQ — deployment settings for docker-compose.yml.
# Copy to `.env` (next to docker-compose.yml) and change at least the three
# values marked CHANGE. Without a .env file the development defaults are used.

# --- web ---------------------------------------------------------------------
# Port the app is published on: http://<host>:APP_PORT
APP_PORT=8080

# --- database ----------------------------------------------------------------
POSTGRES_USER=foodchainiq
# CHANGE:
POSTGRES_PASSWORD=foodchainiq
POSTGRES_DB=foodchainiq
# Host port for the database (bound to 127.0.0.1 only)
DB_PORT=5432

# --- backend -----------------------------------------------------------------
# CHANGE: signs the login tokens. Generate one with:  openssl rand -hex 32
JWT_SECRET=dev-only-change-me-in-production-0123456789

# First platform admin (created on first start if missing)
ADMIN_EMAIL=admin@foodchainiq.local
# CHANGE:
ADMIN_PASSWORD=admin1234

# Demo users, groups and five synthetic datasets on an empty database.
# Set to false for a real deployment.
SEED_DEMO=true
# List the demo accounts in the sign-in dialog (baked into the web build;
# rebuild with `docker compose up -d --build web` after changing).
SHOW_DEMO_ACCOUNTS=false

# true when users reach the app over HTTPS (behind a TLS proxy)
COOKIE_SECURE=false
COOKIE_SAMESITE=strict

# Session lifetimes (seconds)
ACCESS_TOKEN_TTL_S=900
REFRESH_TOKEN_TTL_S=604800

# Upload limit per dataset and default storage quota per user (bytes)
MAX_UPLOAD_BYTES=2147483648
DEFAULT_QUOTA_BYTES=10737418240
